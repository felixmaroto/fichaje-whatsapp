<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Contrata Fichaje WhatsApp</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="barra">
    <span class="marca">Fichaje WhatsApp</span>
  </div>

  <div class="contenedor">
    <h1>Elige tu plan</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <form method="POST" action="/signup/checkout">
      <div class="planes">
        <% Object.entries(planes).forEach(([id, plan], i) => { %>
        <label class="plan <%= i === 0 ? 'seleccionado' : '' %>">
          <input type="radio" name="plan" value="<%= id %>" <%= i === 0 ? 'checked' : '' %>
                 style="display:none" onchange="document.querySelectorAll('.plan').forEach(p=>p.classList.remove('seleccionado')); this.closest('.plan').classList.add('seleccionado')">
          <h3><%= plan.nombre %></h3>
          <div class="precio"><%= plan.precioMensual %>€ <span>/mes</span></div>
          <div class="enlace-secundario">hasta <%= plan.limiteEmpleados %> empleados</div>
        </label>
        <% }) %>
      </div>

      <div class="tarjeta">
        <label for="nombreEmpresa">Nombre de tu empresa</label>
        <input type="text" id="nombreEmpresa" name="nombreEmpresa" required>
        <label for="email">Tu correo (será tu usuario del panel)</label>
        <input type="email" id="email" name="email" required>
        <button type="submit" style="margin-top:14px;">Ir a pagar</button>
        <p class="enlace-secundario" style="margin-top:10px;">
          Pago seguro con Stripe. Puedes cancelar cuando quieras desde el panel.
        </p>
      </div>
    </form>
  </div>
</body>
</html>
